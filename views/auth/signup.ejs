<%- include("../partials/header.ejs");%>
<%- include("../partials/nav.ejs");%>
<section class="container-fluid px-0 mt-5">
    <div class="row align-items-center">
        <div class="col-0 col-lg-3"></div>
        <div class="col-12 col-lg-6 text-center authItems pb-5">
            <h1>Register</h1>
            <form method="POST" action="/auth/register" id="signupForm">
                <div class="mb-3">
                    <label for="firstName" class="form-label">First Name</label>
                    <input type="text" class="form-control" id="firstName" aria-describedby="firstNameHelp" name="firstName">
                    <label for="lastName" class="form-label">Last Name</label>
                    <input type="text" class="form-control" id="lastName" aria-describedby="lastNameHelp" name="lastName">
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email address</label>
                    <input type="email" class="form-control" id="email" aria-describedby="emailHelp" name="email">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" name="password">
                </div>
                <button class="float-btn" type="submit">Register</button>
            </form>
            <%- include("../partials/authflash.ejs");%>
        </div>
        <div class="col-0 col-lg-3"></div>
    </div>
</section>
<%- include("../partials/footer.ejs");%>